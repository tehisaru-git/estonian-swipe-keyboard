<?xml version="1.0" encoding="utf-8"?>
<!-- Estonian phone layout. Its simple Gboard-like appearance is independently styled;
     the current renderer remains CleverKeys until a separate IME view replaces it.
     No Google artwork or proprietary components are included.
     The bound language keeps Estonian swipe/predictions separate from English.
     Number row is built in so the global number-row preference cannot duplicate it.
     Corner gestures retain the engine's editing actions without filling the key faces. -->
<keyboard name="QWERTY (eesti)" script="latin" language="et" theme="look_gboard"
          bottom_row="false" embedded_number_row="true">
  <row height="0.70">
    <key width="1.1" c="1"/><key width="1.1" c="2"/>
    <key width="1.1" c="3"/><key width="1.1" c="4"/>
    <key width="1.1" c="5"/><key width="1.1" c="6"/>
    <key width="1.1" c="7"/><key width="1.1" c="8"/>
    <key width="1.1" c="9"/><key width="1.1" c="0"/>
  </row>
  <row>
    <key c="q"/><key c="w"/><key c="e" se="€"/>
    <key c="r"/><key c="t"/><key c="y"/><key c="u"/>
    <key c="i"/><key c="o"/><key c="p"/><key c="ü"/>
  </row>
  <row>
    <key c="a"/><key c="s" sw="š"/><key c="d"/>
    <key c="f"/><key c="g"/><key c="h"/><key c="j"/>
    <key c="k"/><key c="l"/><key c="ö"/><key c="ä"/>
  </row>
  <row>
    <key width="1.5" c="shift" sw="loc capslock"/>
    <key c="z" sw="ž"/><key c="x"/><key c="c"/>
    <key c="v"/><key c="b"/><key c="n"/><key c="m"/>
    <key c="õ"/>
    <key width="1.5" c="backspace" nw="delete_last_word" ne="delete"/>
  </row>
  <row height="0.95">
    <key width="1.5" c="?123:switch_numeric" nw="ctrl" ne="fn"/>
    <key c=","/>
    <key c="switch_emoji" n="loc change_method" ne="config" sw="loc switch_clipboard" se="switch_gif"/>
    <key width="5" c="space" n="loc switch_forward" s="loc switch_backward" w="cursor_left" e="cursor_right"/>
    <key c="." nw="'" n="\?" ne="!"/>
    <key width="1.5" c="enter" ne="action"/>
  </row>
</keyboard>
